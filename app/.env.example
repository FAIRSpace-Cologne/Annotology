# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# any values you need. Docker Compose loads ".env" automatically — you do
# not need to pass these on the command line.
#
#   cp .env.example .env

# Optional. Only required if you want to use the "BioPortal (NCBO)" lookup
# service. Get a free key from https://bioportal.bioontology.org/account
# (create an account, then copy the key from your account page).
# Leave blank to skip BioPortal — every other lookup service (OLS, TIB,
# ZOOMA, Ontobee) works without any key.
BIOPORTAL_API_KEY=
